{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "engines": {
    "node": "24.12.0",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "predev": "node scripts/check-env.mjs",
    "check-env": "node scripts/check-env.mjs",
    "check-env:mainnet": "node scripts/check-env.mjs --mode mainnet",
    "dev": "vite",
    "validate:assets": "node scripts/validate-public-assets.mjs",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "prebuild": "node scripts/check-env.mjs && node scripts/validate-public-assets.mjs",
    "build": "tsc -b && vite build",
    "build:analyze": "vite build --config vite.config.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate:bindings": "bash ../scripts/generate-bindings.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "cd .. && husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@sentry/react": "^10.68.0",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^16.1.0",
    "@tanstack/react-query": "^5.101.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.83.0",
    "react-joyride": "^3.2.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.5.0",
    "web-vitals": "^6.0.1",
    "workbox-window": "^7.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/react": "^4.12.1",
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^9.39.5",
    "@hookform/resolvers": "^5.5.7",
    "@playwright/test": "^1.62.0",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-storybook": "^10.5.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.2.0",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.5.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  }
}
