# Lernza Frontend Environment Configuration
#
# Instead of manually editing this file, generate it from the central config:
#   node scripts/load-config.mjs <environment> > frontend/.env.local
#
# Supported environments: development, staging, production
#
# Example:
#   node scripts/load-config.mjs staging > frontend/.env.local

# Soroban RPC endpoint for chain interactions
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Network identifier (testnet/mainnet)
VITE_SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Horizon API endpoint
VITE_HORIZON_URL=https://horizon-testnet.stellar.org

# Contract IDs
VITE_QUEST_CONTRACT_ID=CC24Y3HPO4P4UPQ3CRORTCU6QV7YNZL4UNT4EKZUM2NIPPMH2OSTCPC6
VITE_MILESTONE_CONTRACT_ID=CAUQGMW72Z63QD6SVUBLUXJNWTUGCKINFZMFBR7I5WFX7QUI3RE6Q2B3
VITE_REWARDS_CONTRACT_ID=CBZN7TRWULHY6LQZH6YCSHDTPZRY6B6SQPW44JFO7EJCSWASH6ZW3TBD
VITE_REWARDS_TOKEN_CONTRACT_ID=CDLZFC3SYJYDZXTEVRXTHNKVYKKEFZQJ2HW4QGHZ3KIZZMJDJPTKJ7QG
VITE_USDC_TOKEN_ADDRESS=CDLZFC3SYJYDZXTEVRXTHNKVYKKEFZQJ2HW4QGHZ3KIZZMJDJPTKJ7QG

# RPC rate limiting (token bucket)
VITE_RPC_READ_RATE_LIMIT_CAPACITY=100
VITE_RPC_READ_RATE_LIMIT_REFILL_PER_SECOND=10

# Sentry error tracking (leave blank to disable)
VITE_SENTRY_DSN=

# Deployment environment
VITE_ENVIRONMENT=staging
